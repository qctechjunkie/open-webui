# Open WebUI Configuration Example
# Documentation: https://docs.openwebui.com/getting-started/env-configuration
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the values below with your actual configuration
# 3. Never commit the .env file to version control

# ======================================================
# Core Configuration (REQUIRED)
# ======================================================

# Generate a secure random key using: openssl rand -base64 32
# IMPORTANT: Replace this with your own secure key!
WEBUI_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-base64-32

# Your installation URL (required for OAuth/SSO)
# Examples: http://localhost:3000, https://openwebui.example.com
WEBUI_URL=http://localhost:3000

# ======================================================
# Docker Configuration
# ======================================================

# OpenWebUI version tag (main, latest, or specific version like 0.1.0)
WEBUI_VERSION=main

# Port to expose on host machine
WEBUI_PORT=3000

# Docker network name (shared with Ollama if on same host)
NETWORK_NAME=ollama-network

# Volume paths for persistent data (absolute paths)
# Leave empty to use Docker named volumes (recommended for portability)
DOCKER_DATA_PATH=

# ======================================================
# Model Integration
# ======================================================

# Ollama API endpoint
# For Docker on Linux: http://localhost:11434 or http://ollama:11434
# For remote Ollama: http://your-ollama-server:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ======================================================
# Authentication Settings
# ======================================================

# Allow new user registration (true/false)
ENABLE_SIGNUP=false

# Default role for new users: pending, user, or admin
DEFAULT_USER_ROLE=pending

# ======================================================
# OAuth/SSO Configuration (Authentik)
# Leave empty if not using OAuth/SSO
# ======================================================

# OAuth Client ID from your OAuth provider
OAUTH_CLIENT_ID=

# OAuth Client Secret from your OAuth provider
OAUTH_CLIENT_SECRET=

# OAuth Provider Name (for display purposes)
OAUTH_PROVIDER_NAME=authentik

# OpenID Provider URL
# Example: https://auth.example.com/application/o/open-webui/
OPENID_PROVIDER_URL=

# OpenID Redirect URI
# Should match: {WEBUI_URL}/oauth/{OAUTH_PROVIDER_NAME}/callback
# Example: http://localhost:3000/oauth/authentik/callback
OPENID_REDIRECT_URI=

# ======================================================
# Code Interpreter Settings
# ======================================================

# Enable Python code execution in chat (true/false)
ENABLE_CODE_INTERPRETER=true

# ======================================================
# RAG Configuration
# ======================================================

# Embedding model to use for RAG
# Examples: nomic-embed-text, all-MiniLM-L6-v2, text-embedding-3-small
RAG_EMBEDDING_MODEL=nomic-embed-text

# Maximum file size for RAG uploads in MB
RAG_FILE_MAX_SIZE=10

# ======================================================
# PostgreSQL (Global Instance)
# ======================================================

# Container name of the global-postgres instance on this host
POSTGRES_HOST=lxc103-postgres

# Docker network shared with global-postgres (must match NETWORK_NAME in global-postgres .env)
POSTGRES_NETWORK_NAME=lxc103-postgres-network

# Open WebUI database credentials (must match global-postgres .env)
POSTGRES_DB=openwebui
POSTGRES_USER=openwebui_user
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>
