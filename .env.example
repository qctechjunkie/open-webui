# Open WebUI Configuration Example
# Documentation: https://docs.openwebui.com/getting-started/env-configuration
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the values below with your actual configuration
# 3. Never commit the .env file to version control

# ==========================================
# Core Configuration (REQUIRED)
# ==========================================

# Generate a secure random key using: openssl rand -base64 32
# IMPORTANT: Replace this with your own secure key!
WEBUI_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-base64-32

# Your installation URL (required for OAuth/SSO)
# Examples: http://localhost:3000, https://openwebui.example.com
WEBUI_URL=http://localhost:3000

# ==========================================
# Docker Configuration
# ==========================================

# OpenWebUI version tag (main, latest, or specific version like 0.1.0)
WEBUI_VERSION=main

# Port to expose on host machine
WEBUI_PORT=3000

# Docker network name
NETWORK_NAME=ollama-network

# Volume paths for persistent data (absolute paths)
# Leave empty to use Docker named volumes (recommended for portability)
# To use bind mounts instead:
#   1. Set paths below (absolute paths)
#   2. Edit compose.yaml: comment named volumes, uncomment bind mounts
# Windows example: C:/Docker/open-webui/data (use forward slashes)
# Linux example: /home/user/Docker/open-webui/data
DOCKER_DATA_PATH=

# ==========================================
# Model Integration
# ==========================================

# Ollama API endpoint
# For Docker on Windows/Mac: http://host.docker.internal:11434
# For Docker on Linux: http://localhost:11434 or http://ollama:11434
# For remote Ollama: http://your-ollama-server:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ==========================================
# Authentication Settings
# ==========================================

# Allow new user registration (true/false)
ENABLE_SIGNUP=false

# Default role for new users: pending, user, or admin
DEFAULT_USER_ROLE=pending

# ==========================================
# OAuth/SSO Configuration (Authentik)
# Leave empty if not using OAuth/SSO
# ==========================================

# OAuth Client ID from your OAuth provider
OAUTH_CLIENT_ID=

# OAuth Client Secret from your OAuth provider
OAUTH_CLIENT_SECRET=

# OAuth Provider Name (for display purposes)
OAUTH_PROVIDER_NAME=authentik

# OpenID Provider URL
# Example: https://auth.example.com/application/o/open-webui/
OPENID_PROVIDER_URL=

# OpenID Redirect URI
# Should match: {WEBUI_URL}/oauth/{OAUTH_PROVIDER_NAME}/callback
# Example: http://localhost:3000/oauth/authentik/callback
OPENID_REDIRECT_URI=

# ==========================================
# Code Interpreter Settings
# ==========================================

# Enable Python code execution in chat (true/false)
ENABLE_CODE_INTERPRETER=true

# ==========================================
# RAG Configuration
# ==========================================

# Embedding model to use for RAG
# Examples: nomic-embed-text, all-MiniLM-L6-v2, text-embedding-3-small
RAG_EMBEDDING_MODEL=nomic-embed-text

# Maximum file size for RAG uploads in MB
RAG_FILE_MAX_SIZE=10

# ==========================================
# Optional: Additional RAG Settings
# ==========================================

# Chunk size for document processing (default: 1000)
# CHUNK_SIZE=1000

# Chunk overlap for document processing (default: 100)
# CHUNK_OVERLAP=100

# Top K results for RAG retrieval (default: 3)
# RAG_TOP_K=3

# ==========================================
# Optional: Performance & Security
# ==========================================

# JWT token expiration (examples: 4w, 30d, 12h)
# Never use -1 in production!
# JWT_EXPIRES_IN=4w

# Enable secure cookies for HTTPS deployments (true/false)
# Set to true if using HTTPS
# WEBUI_SESSION_COOKIE_SECURE=false

# CORS allowed origins (comma-separated)
# Use * for development, specific domains for production
# CORS_ALLOW_ORIGIN=*

# FastAPI thread pool size (0 = default 40 threads)
# THREAD_POOL_SIZE=0

# Model list cache TTL in seconds (default: 1)
# MODELS_CACHE_TTL=1

# HTTP client timeout in seconds (default: 300)
# AIOHTTP_CLIENT_TIMEOUT=300

# ==========================================
# Optional: Web Search Configuration
# ==========================================

# Enable web search functionality
# ENABLE_WEB_SEARCH=false

# Web search engine (searxng, google, brave, duckduckgo)
# WEB_SEARCH_ENGINE=searxng

# Search result count
# WEB_SEARCH_RESULT_COUNT=3

# ==========================================
# Optional: Image Generation
# ==========================================

# Enable image generation
# ENABLE_IMAGE_GENERATION=false

# Image generation engine (automatic1111, comfyui, openai)
# IMAGE_GENERATION_ENGINE=automatic1111

# ==========================================
# Optional: Database Configuration
# ==========================================

# External database URL (leave empty to use default SQLite)
# Examples:
# PostgreSQL: postgresql://user:password@localhost:5432/openwebui
# MySQL: mysql://user:password@localhost:3306/openwebui
# DATABASE_URL=

# ==========================================
# Optional: Vector Database Configuration
# ==========================================

# Vector database type (chroma, milvus, qdrant, pgvector, etc.)
# Default: chroma (embedded)
# VECTOR_DB=chroma

# ==========================================
# Optional: Cloud Storage
# ==========================================

# Storage provider (s3, gcs, azure)
# STORAGE_PROVIDER=

# S3 Configuration (if using S3)
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION_NAME=us-east-1
# S3_ENDPOINT_URL=

# ==========================================
# Optional: PostgreSQL Docker Settings
# ==========================================
# PostgreSQL Configuration
  POSTGRES_DB=openwebui
  POSTGRES_USER=openwebui_user
  POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>