# Environment Variables (CONTAINS SECRETS - NEVER COMMIT)
.env
.env.local
.env.*.local

# Docker data directories (if using bind mounts instead of volumes)
data/
workspace/
uploads/
cache/
vectors/

# Backups
*.tar.gz
*.zip
backup/
backups/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS Files
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride
Desktop.ini

# Python (if running locally)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Node (if running frontend locally)
node_modules/
npm-debug.log
yarn-error.log
.pnp.*
.yarn/

# Temporary Files
*.tmp
*.temp
tmp/
temp/

# Docker override files (if you create personal overrides)
docker-compose.override.yml
compose.override.yaml

# SSL/TLS Certificates (if storing locally)
*.pem
*.key
*.crt
*.csr
*.cer

# Database files (if using SQLite locally)
*.db
*.sqlite
*.sqlite3

# Coverage and Test Files
coverage/
*.cover
.hypothesis/
.pytest_cache/

# Secrets and Credentials
secrets/
credentials/
*.secret
*.credential
